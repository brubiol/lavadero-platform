# Copy this to /opt/lavadero/.env on the EC2 host and fill in real values.
# Never commit the real .env file.

# RDS connection (from AWS Console → RDS → your instance → Endpoint)
RDS_HOST=your-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_DB=lavadero
RDS_USERNAME=lavadero
RDS_PASSWORD=change-this-strong-password

# JWT — generate with: openssl rand -hex 32
LAVADERO_JWT_SECRET=change-this-to-a-32-byte-random-secret-minimum

# Bootstrap owner account (first login after fresh deploy)
LAVADERO_BOOTSTRAP_USERNAME=dueno
LAVADERO_BOOTSTRAP_PASSWORD=change-this-strong-password
LAVADERO_BOOTSTRAP_FULL_NAME=Brandon Rubio

# AI provider — only the API key is a secret. Provider, base URL, model, and
# timeout are pinned in docker-compose.prod.yml so they can't drift on the host.
LAVADERO_AI_API_KEY=change-this-openai-api-key
