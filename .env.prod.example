# One .env per business instance, at /opt/lavadero/<instance>/.env (mode 600).
# scripts/setup-secrets.sh writes this for you. Never commit the real file.

# Instance name: lowercase letters/digits/dashes. Prefixes container names
# (<instance>-api, <instance>-postgres, <instance>-web). Keep "lavadero" for
# the first business so the existing backup/restore scripts work unchanged.
LAVADERO_INSTANCE=lavadero
LAVADERO_DOMAIN=turbolavado.org

# Postgres runs in Docker next to the API (data in a named volume).
POSTGRES_DB=lavadero
POSTGRES_USER=lavadero
POSTGRES_PASSWORD=change-this-strong-password

# JWT — generate with: openssl rand -hex 32
LAVADERO_JWT_SECRET=change-this-to-a-32-byte-random-secret-minimum

# Bootstrap owner account (DUENO — Eric Rubio). First login after fresh deploy.
LAVADERO_BOOTSTRAP_USERNAME=dueno
LAVADERO_BOOTSTRAP_PASSWORD=change-this-strong-password
LAVADERO_BOOTSTRAP_FULL_NAME=Eric Rubio

# Bootstrap admin account (ADMIN — Brandon Rubio, engineer). Sees everything plus
# in-development features. Created on startup if it doesn't already exist.
LAVADERO_ADMIN_USERNAME=brandon
LAVADERO_ADMIN_PASSWORD=change-this-strong-password
LAVADERO_ADMIN_FULL_NAME=Brandon Rubio

# AI provider — only the API key is a secret. Provider, base URL, model, and
# timeout are pinned in docker-compose.prod.yml so they can't drift on the host.
# Leave blank to use the free deterministic fallback.
LAVADERO_AI_API_KEY=

# Off-site backups (Oracle Object Storage, S3-compatible). Used by
# scripts/backup-offsite.sh. Create a "Customer Secret Key" in the OCI console.
BACKUP_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
BACKUP_S3_BUCKET=lavadero-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
